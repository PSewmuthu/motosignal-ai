# Data Configurations
MOTOSIGNAL_DATA_DIR='./data'
DATABASE_URL='your database url here'

# AI Model Configurations
MOTOSIGNAL_MOTORCYCLE_MODEL='your motorcycle detection model here (e.g., yolov12n.pt)'
MOTOSIGNAL_MOTORCYCLE_CLASS_ID='your motorcycle class id here'
MOTOSIGNAL_MOTORCYCLE_CONFIDENCE='your motorcycle confidence threshold here (0.0 - 1.0)'
MOTOSIGNAL_MOTORCYCLE_NMS_IOU='your motorcycle NMS IoU threshold here (0.0 - 1.0)'
MOTOSIGNAL_MOTORCYCLE_IMAGE_SIZE='your motorcycle image size here (e.g., 640)'
MOTOSIGNAL_YOLO_DEVICE='your YOLO device here (e.g., cpu, cuda:0)'
MOTOSIGNAL_TRACKER_CONFIG='your tracker configuration file path here'
MOTOSIGNAL_ENABLE_OCR='your OCR enable flag here (true or false)'
MOTOSIGNAL_FRAME_STRIDE='your frame stride value here (e.g., 1 for every frame, 2 for every other frame)'
MOTOSIGNAL_MAX_UPLOAD_MB='your maximum upload size in MB here (e.g., 500)'
